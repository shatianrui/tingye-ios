    "导入 CBZ 或图片 ZIP 压缩包，会在这里以漫画模式阅读。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a CBZ or image ZIP archive to read it here in comic mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CBZ や画像 ZIP を読み込むと、ここでマンガモードで読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 CBZ 或图片 ZIP 压缩包，会在这里以漫画模式阅读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入 CBZ 或圖片 ZIP 壓縮包，會在這裡以漫畫模式閱讀。"
          }
        }
      }
    },
    "导入 EPUB、TXT、PDF 或 MOBI，可以读，也可以合上眼睛听。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import EPUB, TXT, PDF or MOBI to read, or close your eyes and listen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "EPUB・TXT・PDF・MOBI を読み込んで、読むことも、目を閉じて聴くこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 EPUB、TXT、PDF 或 MOBI，可以读，也可以合上眼睛听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導入 EPUB、TXT、PDF 或 MOBI，可以讀，也可以合上眼睛聽。"
          }
        }
      }
    },
