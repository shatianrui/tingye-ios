        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop preview"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試聴を停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止试听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止試聽"
          }
        }
      }
    },
    "先在临时目录写入全部书籍，成功后才替换本机书库。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All books are written to a temporary folder first; your local library is replaced only after that succeeds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての本をまず一時フォルダに書き込み、成功してから端末のライブラリを置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在临时目录写入全部书籍，成功后才替换本机书库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在臨時目錄寫入全部書籍，成功後才替換本機書庫。"
          }
        }
      }
    },
    "先查看备份日期与书籍数量。确认还原后，会替换对应书籍的内容、进度与书摘，其余书籍保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the backup date and book count first. After you confirm, matching books’ content, progress and highlights are replaced; other books are kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずバックアップの日付と冊数を確認してください。復元すると該当する本の内容・進捗・抜き書きが置き換わり、ほかの本は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先查看备份日期与书籍数量。确认还原后，会替换对应书籍的内容、进度与书摘，其余书籍保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先查看備份日期與書籍數量。確認還原後，會替換對應書籍的內容、進度與書摘，其餘書籍保留。"
          }
        }
      }
    },
