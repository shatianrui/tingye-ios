    "区域必须与 Azure 语音资源所在区域一致（在 Azure 门户的「密钥和终结点」中查看）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The region must match your Azure Speech resource (see “Keys and Endpoint” in the Azure portal)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リージョンは Azure 音声リソースと一致させてください（Azure ポータルの「キーとエンドポイント」で確認できます）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "区域必须与 Azure 语音资源所在区域一致（在 Azure 门户的「密钥和终结点」中查看）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
