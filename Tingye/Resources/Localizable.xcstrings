    "坚果云、群晖、Nextcloud 等文件服务器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jianguoyun, Synology, Nextcloud and other file servers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
