      }
    },
    "使用你自己的 API Key 直连服务商，音质更自然，按服务商计费。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own API key to connect directly; voices are more natural and billed by the provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の API キーで直接接続します。より自然な声で、料金はプロバイダの規定に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 API Key 直连服务商，音质更自然，按服务商计费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 API Key 直連服務商，音質更自然，按服務商計費。"
          }
        }
      }
    },
    "使用你自己的 Azure 语音资源（Speech Key + 区域），提供大量中文神经网络音色，有免费额度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own Azure Speech resource (Speech Key + region) with many Chinese neural voices and a free tier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の Azure 音声リソース（Speech Key + リージョン）を使います。中国語のニューラル音声が多く、無料枠もあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 Azure 语音资源（Speech Key + 区域），提供大量中文神经网络音色，有免费额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 Azure 語音資源（Speech Key + 區域），提供大量中文神經網絡音色，有免費額度。"
          }
        }
      }
    },
    "使用你自己的 ElevenLabs API Key，多语言音色自然，带逐字时间戳。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own ElevenLabs API key for natural multilingual voices with word timestamps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の ElevenLabs API キーを使います。自然な多言語の声で、単語ごとのタイムスタンプ付きです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 ElevenLabs API Key，多语言音色自然，带逐字时间戳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的 ElevenLabs API Key，多語言音色自然，帶逐字時間戳。"
          }
        }
      }
    },
    "使用设备自带声音，无需联网、免费。可在系统设置 → 辅助功能 → 朗读内容 → 声音中下载更多声音。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the device’s built-in voices: offline and free. Download more in Settings → Accessibility → Spoken Content → Voices."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内蔵の声を使い、オフライン・無料です。設定 → アクセシビリティ → 読み上げコンテンツ → 声 で追加の声をダウンロードできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用设备自带声音，无需联网、免费。可在系统设置 → 辅助功能 → 朗读内容 → 声音中下载更多声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用設備自帶聲音，無需聯網、免費。可在系統設置 → 輔助功能 → 朗讀內容 → 聲音中下載更多聲音。"
          }
        }
      }
    },
